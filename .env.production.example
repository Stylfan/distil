# Copy to .env.production and fill in. Never commit the copy.
# Make each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# The Postgres owner's password; used only by the migration step.
POSTGRES_PASSWORD=
# The application role's password (distil_app).
DISTIL_APP_PASSWORD=
# Encrypts the two-step secrets at rest. Do not change it once people use 2FA.
DISTIL_SECRET=
# The public address, with https. Passkeys are bound to it.
DISTIL_URL=https://distil.example.dk
# Anyone may create an account; "closed" stops that after the first one.
DISTIL_SIGNUP=

# Mistral reads the photos (docs/adr/0001-mistral-reads-the-photos.md).
MISTRAL_API_KEY=
# A vision model; defaults to mistral-medium-latest.
DISTIL_MISTRAL_MODEL=
# Photos a new account may have read (default 10), and the installation per day (default 300).
DISTIL_PHOTO_ALLOWANCE=
DISTIL_DAILY_PHOTO_LIMIT=

# Only when you host Distil for other people: who runs it. With a name
# and an address to write to, the sign-in pages link to a privacy policy
# and terms in that name (/privatliv and /vilkaar); without, there are none.
DISTIL_OPERATOR_NAME=
DISTIL_OPERATOR_EMAIL=
# Address and CVR number on one line, e.g. "Vej 1, 1000 København · CVR 12345678".
DISTIL_OPERATOR_ADDRESS=
# Who runs the server and backups for you, e.g. "Hetzner Online GmbH i Tyskland".
DISTIL_HOSTING=

# "on" makes this a demo: visitors press one button and get a throwaway
# account, deleted after 24 hours; no sign-up unless DISTIL_SIGNUP=open.
DISTIL_DEMO=
# Where visitors fetch the code; defaults to the GitHub repository.
DISTIL_SOURCE_URL=
