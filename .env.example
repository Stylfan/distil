# Copy to .env. The defaults match docker-compose.dev.yml and are for a
# development machine only.

# The database owner: runs migrations.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/distil
# The application's own role, subject to row-level security.
APP_DATABASE_URL=postgres://distil_app:distil_app@127.0.0.1:5434/distil
# The password migrations give distil_app; must match APP_DATABASE_URL.
DISTIL_APP_PASSWORD=distil_app

# Anyone may create an account; "closed" stops that after the first one.
# DISTIL_SIGNUP=closed

# Mistral reads the photos. Without a key, DISTIL_READER=fake gives made-up
# notes so the app can be tried.
# MISTRAL_API_KEY=
# DISTIL_READER=fake
# DISTIL_MISTRAL_MODEL=mistral-medium-latest
# DISTIL_PHOTO_ALLOWANCE=10
# DISTIL_DAILY_PHOTO_LIMIT=300

# Only when hosting for others: who runs this installation (see docs/self-hosting.md).
# DISTIL_OPERATOR_NAME=
# DISTIL_OPERATOR_EMAIL=
# DISTIL_OPERATOR_ADDRESS=
# DISTIL_HOSTING=

# Encrypts the two-step secrets at rest. At least 32 random characters;
# keep it out of the repository and do not change it once people use 2FA.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DISTIL_SECRET=

# The address Distil is served from, e.g. https://distil.example.dk.
# Passkeys are bound to it. On localhost it may be left out.
# DISTIL_URL=
